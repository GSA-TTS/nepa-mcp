# Keep the build context (repo root) minimal and ensure no secrets or local
# state are baked into the image. The per-user CENSUS_API_KEY is injected at
# runtime by the gateway, never copied into the image.
#
# NOTE: this .dockerignore lives in the repo root's docker/census/ dir, but
# Docker only reads a .dockerignore at the build-context root. Kept here for
# documentation and for `docker build -f` invocations that honor
# <dockerfile>.dockerignore.

# Virtual envs / caches
.venv/
**/.venv/
**/__pycache__/
*.pyc

# VCS / editor
.git/
.gitignore
.vscode/
.agents/

# Tests, docs, and other servers not needed for the Census image
tests/
docs/
scripts/

# Local env files (never bake secrets)
.env
*.env
.env.*
