# Keep the build context (repo root) minimal and ensure no secrets or local
# state are baked into the image. TIGERweb Counties queries public Census ArcGIS
# services, so no credentials are needed at all.
#
# NOTE: this .dockerignore lives in the repo root's docker/tigerweb_counties/
# dir, but Docker only reads a .dockerignore at the build-context root. Kept here
# for documentation and for `docker build -f` invocations that honor
# <dockerfile>.dockerignore.

# Virtual envs / caches
.venv/
**/.venv/
**/__pycache__/
*.pyc

# VCS / editor
.git/
.gitignore
.vscode/
.agents/

# Tests, docs, and other servers not needed for the image
tests/
docs/
scripts/

# Local env files (never bake secrets)
.env
*.env
.env.*
